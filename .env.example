# Copy to .env and fill in. .env is gitignored; never commit real tokens.
# GLPI as the container reaches it (e.g. its container name on a shared Docker network).
# GLPI sees the container's address, which the API client's IP range must allow.
GLPI_URL=http://glpi
# GLPI as a browser reaches it - every link on the page points here
GLPI_PUBLIC_URL=https://glpi.example.com
# App token of the GLPI API client 'dashboard'
GLPI_APP_TOKEN=changeme
# API token of the read-only GLPI user 'dashboard' (Remote access keys on the user's settings)
GLPI_USER_TOKEN=changeme
REFRESH_SECONDS=300
# CIs that count as internet-facing: everything these impact in GLPI's impact graph (e.g. your
# reverse proxy), plus the extras (e.g. the firewall). Comma-separated GLPI CI names; empty = none.
INTERNET_FACING_ROOTS=reverse-proxy
INTERNET_FACING_EXTRA=firewall
